{
	"name": "@toreda/verify",
	"version": "0.13.0",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"repository": "https://github.com/toreda/verify",
	"author": "Toreda, Inc.",
	"sideEffects": false,
	"keywords": [
		"schema-validation",
		"validation-rules",
		"json-schema",
		"typescript"
	],
	"license": "MIT",
	"packageManager": "pnpm@11.19.0",
	"description": "Automated validation. Eliminate edge cases with less code.",
	"publishConfig": {
		"access": "public"
	},
	"prettier": "@toreda/prettier-config",
	"devDependencies": {
		"@8hobbies/typedoc-plugin-404": "^3.2.1",
		"@knodes/typedoc-plugin-code-blocks": "^0.23.4",
		"@swc/core": "^1.15.46",
		"@swc/jest": "^0.2.39",
		"@toreda/build-tools": "^0.8.0",
		"@toreda/eslint-config": "^2.2.0",
		"@toreda/prettier-config": "^1.0.1",
		"@toreda/strong-types": "^0.28.5",
		"@toreda/time": "^0.2.0",
		"@toreda/types": "^2.16.0",
		"@types/babel__traverse": "^7.20.7",
		"@types/big.js": "^6.2.2",
		"@types/eslint": "^9.6.1",
		"@types/gulp": "^4.0.17",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.15.30",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@typescript-eslint/typescript-estree": "^8.67.0",
		"@typescript-eslint/utils": "^8.67.0",
		"@typhonjs-typedoc/typedoc-pkg": "^0.4.2",
		"big.js": "^6.2.2",
		"cross-env": "^10.1.0",
		"eslint": "9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"gulp": "^5.0.1",
		"jest": "^30.4.2",
		"jest-cli": "^30.4.2",
		"jest-junit": "^17.0.0",
		"madge": "^8.0.0",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"tsdown": "^0.22.14",
		"typedoc": "~0.28.20",
		"typedoc-plugin-coverage": "^4.0.3",
		"typedoc-plugin-extras": "^4.0.1",
		"typedoc-plugin-include-example": "^3.0.2",
		"typedoc-plugin-mdn-links": "^3.3.8",
		"typedoc-plugin-pages": "^1.1.0",
		"typescript": "^5.9.3",
		"unrun": "^0.3.1"
	},
	"peerDependencies": {
		"@toreda/fate": "^0.7.0",
		"@toreda/strong-types": "^0.28.5",
		"@toreda/time": "^0.2.0",
		"big.js": "^6.2.1"
	},
	"scripts": {
		"build": "pnpm build:prod",
		"build:prod": "tsdown",
		"build:dev": "tsdown --no-clean --no-dts",
		"test": "cross-env COVERAGE=full jest --coverage",
		"test:ci": "cross-env COVERAGE=full jest --ci --coverage --maxWorkers=50% --reporters=default --reporters=jest-junit",
		"test:fast": "cross-env COVERAGE=summary jest --bail --coverage",
		"make:docs": "pnpm typedoc --options ./typedoc.config.js --plugin @8hobbies/typedoc-plugin-404 --plugin @knodes/typedoc-plugin-code-blocks",
		"make:depgraph": "pnpm madge src/index.ts --image dependency-graph.png"
	},
	"dependencies": {
		"@toreda/shared-types": "^3.0.0"
	}
}
