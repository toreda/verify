{
	"exclude": ["**/node_modules", "dist/**", "**/tests/**/*.ts"],
	"include": ["./src/*.ts", "./src/**/*.ts", "typedoc.config.js"],
	"compilerOptions": {
		"allowUnreachableCode": false,
		"declaration": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "./dist",
		"removeComments": false,
		"rootDir": "./src",
		"sourceMap": true,
		"strict": true,
		"target": "ESNext",
		"types": ["node"]
	},
	"ts-node": {
		"swc": true,
		"compilerOptions": {
			"allowSyntheticDefaultImports": true,
			"noLib": true,
			"noEmit": true,
			"sourceMap": false
		}
	}
}
